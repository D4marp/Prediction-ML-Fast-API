<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>FastAPI Application</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            color: white;
            margin-bottom: 30px;
        }

        header h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
            text-shadow: 2px 2px 4px rgba(0,0,0,0.3);
        }

        header p {
            font-size: 1.1em;
            opacity: 0.9;
        }

        .main-content {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .section {
            background: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.2);
        }

        .section h2 {
            color: #667eea;
            margin-bottom: 20px;
            font-size: 1.5em;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }

        .form-group {
            margin-bottom: 15px;
        }

        label {
            display: block;
            margin-bottom: 5px;
            color: #333;
            font-weight: 500;
        }

        input, textarea {
            width: 100%;
            padding: 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 1em;
            font-family: inherit;
        }

        input:focus, textarea:focus {
            outline: none;
            border-color: #667eea;
            box-shadow: 0 0 5px rgba(102, 126, 234, 0.3);
        }

        button {
            background-color: #667eea;
            color: white;
            padding: 12px 25px;
            border: none;
            border-radius: 5px;
            cursor: pointer;
            font-size: 1em;
            font-weight: 600;
            transition: background-color 0.3s;
            width: 100%;
        }

        button:hover {
            background-color: #5568d3;
        }

        button:active {
            transform: scale(0.98);
        }

        .button-secondary {
            background-color: #6c757d;
            margin-top: 10px;
        }

        .button-secondary:hover {
            background-color: #5a6268;
        }

        .alert {
            padding: 12px;
            border-radius: 5px;
            margin-bottom: 15px;
            display: none;
        }

        .alert.success {
            background-color: #d4edda;
            color: #155724;
            border: 1px solid #c3e6cb;
            display: block;
        }

        .alert.error {
            background-color: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            display: block;
        }

        .alert.info {
            background-color: #d1ecf1;
            color: #0c5460;
            border: 1px solid #bee5eb;
            display: block;
        }

        .response-box {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 15px;
            margin-top: 15px;
            max-height: 300px;
            overflow-y: auto;
        }

        .response-box pre {
            margin: 0;
            white-space: pre-wrap;
            word-wrap: break-word;
            font-size: 0.9em;
        }

        .items-list {
            margin-top: 20px;
        }

        .item-card {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 10px;
        }

        .item-card h4 {
            color: #667eea;
            margin-bottom: 8px;
        }

        .item-card p {
            margin: 5px 0;
            color: #555;
            font-size: 0.95em;
        }

        .item-actions {
            display: flex;
            gap: 10px;
            margin-top: 10px;
        }

        .item-actions button {
            flex: 1;
            padding: 8px;
            font-size: 0.9em;
        }

        .users-list {
            margin-top: 20px;
        }

        .user-card {
            background-color: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 5px;
            padding: 15px;
            margin-bottom: 10px;
        }

        .user-card h4 {
            color: #667eea;
            margin-bottom: 8px;
        }

        .user-card p {
            margin: 5px 0;
            color: #555;
            font-size: 0.95em;
        }

        .token-display {
            background-color: #fff3cd;
            border: 1px solid #ffc107;
            border-radius: 5px;
            padding: 12px;
            margin-top: 15px;
            word-break: break-all;
            font-size: 0.9em;
            font-family: 'Courier New', monospace;
        }

        .full-width {
            grid-column: 1 / -1;
        }

        @media (max-width: 768px) {
            .main-content {
                grid-template-columns: 1fr;
            }

            header h1 {
                font-size: 1.8em;
            }

            .section {
                padding: 15px;
            }
        }

        .loading {
            opacity: 0.6;
            pointer-events: none;
        }

        .spinner {
            display: inline-block;
            width: 12px;
            height: 12px;
            border: 2px solid #f3f3f3;
            border-top: 2px solid #667eea;
            border-radius: 50%;
            animation: spin 0.6s linear infinite;
            margin-right: 5px;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .features {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
            gap: 15px;
            margin-bottom: 30px;
        }

        .feature-card {
            background: white;
            padding: 15px;
            border-radius: 8px;
            text-align: center;
            box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        }

        .feature-card h3 {
            color: #667eea;
            margin-bottom: 8px;
        }

        .feature-card p {
            color: #666;
            font-size: 0.9em;
        }

        .hidden {
            display: none;
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🚀 FastAPI Application</h1>
            <p>Manajemen User, Item, dan Prediksi Penjualan</p>
        </header>

        <div class="features">
            <div class="feature-card">
                <h3>👥 User Management</h3>
                <p>Buat dan kelola user dengan aman</p>
            </div>
            <div class="feature-card">
                <h3>📦 Item Management</h3>
                <p>CRUD penuh untuk item/produk</p>
            </div>
            <div class="feature-card">
                <h3>🤖 Sales Prediction</h3>
                <p>Prediksi penjualan dengan ML</p>
            </div>
            <div class="feature-card">
                <h3>🔐 Authentication</h3>
                <p>JWT Token based security</p>
            </div>
        </div>

        <div class="main-content">
            <!-- REGISTER SECTION -->
            <div class="section">
                <h2>📝 Register User</h2>
                <div id="registerAlert" class="alert"></div>
                <form id="registerForm">
                    <div class="form-group">
                        <label for="regUsername">Username</label>
                        <input type="text" id="regUsername" required placeholder="username">
                    </div>
                    <div class="form-group">
                        <label for="regEmail">Email</label>
                        <input type="email" id="regEmail" required placeholder="email@example.com">
                    </div>
                    <div class="form-group">
                        <label for="regFullName">Full Name</label>
                        <input type="text" id="regFullName" placeholder="John Doe">
                    </div>
                    <div class="form-group">
                        <label for="regPassword">Password</label>
                        <input type="password" id="regPassword" required placeholder="password123">
                    </div>
                    <button type="submit">Register</button>
                </form>
            </div>

            <!-- LOGIN SECTION -->
            <div class="section">
                <h2>🔑 Login</h2>
                <div id="loginAlert" class="alert"></div>
                <form id="loginForm">
                    <div class="form-group">
                        <label for="loginUsername">Username</label>
                        <input type="text" id="loginUsername" required placeholder="username">
                    </div>
                    <div class="form-group">
                        <label for="loginPassword">Password</label>
                        <input type="password" id="loginPassword" required placeholder="password123">
                    </div>
                    <button type="submit">Login</button>
                </form>
                <div id="tokenDisplay" class="token-display hidden">
                    <strong>Access Token:</strong><br>
                    <span id="tokenValue"></span>
                </div>
            </div>

            <!-- GET USER SECTION -->
            <div class="section">
                <h2>👤 Get User</h2>
                <div id="getUserAlert" class="alert"></div>
                <form id="getUserForm">
                    <div class="form-group">
                        <label for="getUsername">Username</label>
                        <input type="text" id="getUsername" required placeholder="username">
                    </div>
                    <button type="submit">Get User</button>
                </form>
                <div id="userResponse" class="response-box hidden">
                    <pre id="userResponseContent"></pre>
                </div>
            </div>

            <!-- CREATE ITEM SECTION -->
            <div class="section">
                <h2>➕ Create Item</h2>
                <div id="createItemAlert" class="alert"></div>
                <form id="createItemForm">
                    <div class="form-group">
                        <label for="itemName">Item Name</label>
                        <input type="text" id="itemName" required placeholder="Product name">
                    </div>
                    <div class="form-group">
                        <label for="itemDescription">Description</label>
                        <textarea id="itemDescription" placeholder="Product description" rows="3"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="itemPrice">Price</label>
                        <input type="number" id="itemPrice" required placeholder="0.00" step="0.01" min="0">
                    </div>
                    <div class="form-group">
                        <label for="itemAvailable">
                            <input type="checkbox" id="itemAvailable" checked> Available
                        </label>
                    </div>
                    <button type="submit">Create Item</button>
                </form>
            </div>

            <!-- GET ITEMS SECTION -->
            <div class="section">
                <h2>📋 All Items</h2>
                <div id="getItemsAlert" class="alert"></div>
                <button onclick="getItems()">Load Items</button>
                <div id="itemsList" class="items-list"></div>
            </div>

            <!-- UPDATE/DELETE ITEM SECTION -->
            <div class="section">
                <h2>✏️ Update/Delete Item</h2>
                <div id="updateItemAlert" class="alert"></div>
                <form id="updateItemForm">
                    <div class="form-group">
                        <label for="updateItemId">Item ID</label>
                        <input type="text" id="updateItemId" required placeholder="Item UUID">
                    </div>
                    <div class="form-group">
                        <label for="updateItemName">Item Name (optional)</label>
                        <input type="text" id="updateItemName" placeholder="Leave empty to keep current">
                    </div>
                    <div class="form-group">
                        <label for="updateItemPrice">Price (optional)</label>
                        <input type="number" id="updateItemPrice" placeholder="Leave empty to keep current" step="0.01" min="0">
                    </div>
                    <button type="submit">Update Item</button>
                    <button type="button" class="button-secondary" onclick="deleteItem()">Delete Item</button>
                </form>
            </div>

            <!-- SALES PREDICTION SECTION -->
            <div class="section">
                <h2>🤖 Sales Prediction</h2>
                <div id="predictionAlert" class="alert"></div>
                <div style="color: #666; margin-bottom: 15px; font-size: 0.9em;">
                    <strong>Note:</strong> Anda harus login terlebih dahulu untuk menggunakan fitur ini.
                </div>
                <form id="predictionForm">
                    <div class="form-group">
                        <label for="predictionFeatures">Features (comma-separated)</label>
                        <input type="text" id="predictionFeatures" required placeholder="e.g., 50.0, 100.0, 25.5">
                    </div>
                    <button type="submit">Predict Sales</button>
                </form>
                <div id="predictionResponse" class="response-box hidden">
                    <pre id="predictionResponseContent"></pre>
                </div>
            </div>

            <!-- STATUS SECTION -->
            <div class="section full-width">
                <h2>ℹ️ API Status</h2>
                <div id="statusAlert" class="alert"></div>
                <button onclick="getStatus()">Check Status</button>
                <div id="statusResponse" class="response-box hidden">
                    <pre id="statusResponseContent"></pre>
                </div>
            </div>
        </div>
    </div>

    <script>
        const API_BASE = 'http://localhost:8000';
        let currentToken = localStorage.getItem('access_token') || null;

        // Update token display on load
        if (currentToken) {
            displayToken(currentToken);
        }

        // REGISTER
        document.getElementById('registerForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alert = document.getElementById('registerAlert');
            
            const data = {
                username: document.getElementById('regUsername').value,
                email: document.getElementById('regEmail').value,
                full_name: document.getElementById('regFullName').value,
                password: document.getElementById('regPassword').value
            };

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/users/`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (response.ok) {
                    showAlert(alert, `✅ User ${data.username} berhasil didaftarkan!`, 'success');
                    document.getElementById('registerForm').reset();
                } else {
                    showAlert(alert, `❌ ${result.detail || 'Error'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        });

        // LOGIN
        document.getElementById('loginForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alert = document.getElementById('loginAlert');
            
            const formData = new FormData();
            formData.append('username', document.getElementById('loginUsername').value);
            formData.append('password', document.getElementById('loginPassword').value);

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/token`, {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                
                if (response.ok) {
                    currentToken = result.access_token;
                    localStorage.setItem('access_token', currentToken);
                    displayToken(currentToken);
                    showAlert(alert, '✅ Login berhasil!', 'success');
                    document.getElementById('loginForm').reset();
                } else {
                    showAlert(alert, `❌ ${result.detail || 'Login gagal'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        });

        // GET USER
        document.getElementById('getUserForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alert = document.getElementById('getUserAlert');
            const username = document.getElementById('getUsername').value;

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/users/${username}`);
                const result = await response.json();
                
                if (response.ok) {
                    showAlert(alert, '', 'info');
                    document.getElementById('userResponse').classList.remove('hidden');
                    document.getElementById('userResponseContent').textContent = JSON.stringify(result, null, 2);
                } else {
                    showAlert(alert, `❌ ${result.detail || 'User tidak ditemukan'}`, 'error');
                    document.getElementById('userResponse').classList.add('hidden');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        });

        // CREATE ITEM
        document.getElementById('createItemForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alert = document.getElementById('createItemAlert');
            
            const data = {
                name: document.getElementById('itemName').value,
                description: document.getElementById('itemDescription').value,
                price: parseFloat(document.getElementById('itemPrice').value),
                available: document.getElementById('itemAvailable').checked
            };

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/items/`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (response.ok) {
                    showAlert(alert, `✅ Item "${data.name}" berhasil dibuat!`, 'success');
                    document.getElementById('createItemForm').reset();
                    getItems();
                } else {
                    showAlert(alert, `❌ ${result.detail || 'Error'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        });

        // GET ITEMS
        async function getItems() {
            const alert = document.getElementById('getItemsAlert');
            const listContainer = document.getElementById('itemsList');
            
            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/items/`);
                const items = await response.json();
                
                if (response.ok) {
                    showAlert(alert, '', 'info');
                    listContainer.innerHTML = '';
                    
                    if (items.length === 0) {
                        listContainer.innerHTML = '<p style="color: #999;">Tidak ada item.</p>';
                    } else {
                        items.forEach(item => {
                            const card = document.createElement('div');
                            card.className = 'item-card';
                            card.innerHTML = `
                                <h4>${item.name}</h4>
                                <p><strong>ID:</strong> ${item.id}</p>
                                <p><strong>Description:</strong> ${item.description || '-'}</p>
                                <p><strong>Price:</strong> Rp ${item.price.toLocaleString('id-ID')}</p>
                                <p><strong>Available:</strong> ${item.available ? '✅ Ya' : '❌ Tidak'}</p>
                            `;
                            listContainer.appendChild(card);
                        });
                    }
                } else {
                    showAlert(alert, `❌ ${items.detail || 'Error'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        }

        // UPDATE ITEM
        document.getElementById('updateItemForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alert = document.getElementById('updateItemAlert');
            const itemId = document.getElementById('updateItemId').value;
            
            const data = {};
            if (document.getElementById('updateItemName').value) {
                data.name = document.getElementById('updateItemName').value;
            }
            if (document.getElementById('updateItemPrice').value) {
                data.price = parseFloat(document.getElementById('updateItemPrice').value);
            }

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/items/${itemId}`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(data)
                });

                const result = await response.json();
                
                if (response.ok) {
                    showAlert(alert, '✅ Item berhasil diupdate!', 'success');
                    document.getElementById('updateItemForm').reset();
                    getItems();
                } else {
                    showAlert(alert, `❌ ${result.detail || 'Error'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        });

        // DELETE ITEM
        async function deleteItem() {
            const alert = document.getElementById('updateItemAlert');
            const itemId = document.getElementById('updateItemId').value;

            if (!itemId) {
                showAlert(alert, '❌ Masukkan Item ID terlebih dahulu', 'error');
                return;
            }

            if (!confirm('Anda yakin ingin menghapus item ini?')) {
                return;
            }

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/items/${itemId}`, {
                    method: 'DELETE'
                });

                if (response.ok) {
                    showAlert(alert, '✅ Item berhasil dihapus!', 'success');
                    document.getElementById('updateItemForm').reset();
                    getItems();
                } else {
                    const result = await response.json();
                    showAlert(alert, `❌ ${result.detail || 'Error'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        }

        // SALES PREDICTION
        document.getElementById('predictionForm').addEventListener('submit', async (e) => {
            e.preventDefault();
            const alert = document.getElementById('predictionAlert');

            if (!currentToken) {
                showAlert(alert, '❌ Anda harus login terlebih dahulu', 'error');
                return;
            }

            const featuresStr = document.getElementById('predictionFeatures').value;
            const features = featuresStr.split(',').map(f => parseFloat(f.trim()));

            if (features.some(isNaN)) {
                showAlert(alert, '❌ Input features tidak valid', 'error');
                return;
            }

            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/predict-sales/`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'Authorization': `Bearer ${currentToken}`
                    },
                    body: JSON.stringify(features)
                });

                const result = await response.json();
                
                if (response.ok) {
                    showAlert(alert, '', 'info');
                    document.getElementById('predictionResponse').classList.remove('hidden');
                    document.getElementById('predictionResponseContent').textContent = JSON.stringify(result, null, 2);
                } else {
                    showAlert(alert, `❌ ${result.detail || 'Error'}`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        });

        // GET STATUS
        async function getStatus() {
            const alert = document.getElementById('statusAlert');
            
            try {
                showAlert(alert, 'Loading...', 'info');
                const response = await fetch(`${API_BASE}/`);
                const result = await response.json();
                
                if (response.ok) {
                    showAlert(alert, '', 'info');
                    document.getElementById('statusResponse').classList.remove('hidden');
                    document.getElementById('statusResponseContent').textContent = JSON.stringify(result, null, 2);
                } else {
                    showAlert(alert, `❌ Error`, 'error');
                }
            } catch (error) {
                showAlert(alert, `❌ Error: ${error.message}`, 'error');
            }
        }

        // HELPER FUNCTIONS
        function showAlert(element, message, type) {
            element.textContent = message;
            element.className = `alert ${type}`;
        }

        function displayToken(token) {
            const display = document.getElementById('tokenDisplay');
            const value = document.getElementById('tokenValue');
            value.textContent = token;
            display.classList.remove('hidden');
        }

        // Load items on page load
        window.addEventListener('load', () => {
            getItems();
        });
    </script>
</body>
</html>
